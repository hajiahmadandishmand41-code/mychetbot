# Copy this file to /opt/mychatbot/.env.production on the VPS.
# chmod 600 /opt/mychatbot/.env.production

# Public DNS name used by Caddy for automatic HTTPS.
MYCHATBOT_DOMAIN=bot.example.com

# Optional public liveness URL. Leave empty to skip the external check.
PUBLIC_HEALTH_URL=https://bot.example.com/health

# Runtime security profiles: VPS must never expose Android/Termux/local tools.
TOOL_PROFILE=server
API_TOOL_PROFILE=server
TRUST_PROXY=true

# AI provider configuration: set only the provider you actually use.
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Required for protected API endpoints.
API_TOKEN=

# Optional: stable Fernet key. If empty, the app creates /data/.master.key once.
MYCHATBOT_MASTER_KEY=

# Telegram bot security (used when the Telegram interface runs on this host).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_REQUIRE_ALLOWLIST=true

# Deployment workflow injects MYCHATBOT_IMAGE; do not hard-code a release tag here.
