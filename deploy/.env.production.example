# Copy this file to /opt/mychatbot/.env.production.
# chmod 600 /opt/mychatbot/.env.production

# Public DNS name used by Caddy for automatic HTTPS.
MYCHATBOT_DOMAIN=bot.example.com
PUBLIC_HEALTH_URL=https://bot.example.com/health

# Runtime security profile: VPS must never expose Android/Termux/local tools.
TOOL_PROFILE=server
TRUST_PROXY=true

# NaraRouter configuration. Model is environment-only.
NARA_BASE_URL=https://router.bynara.id/v1
NARA_API_KEY=
DEFAULT_MODEL=

# Protected API access.
API_TOKEN=
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Persistent memory encryption key. If empty, the app creates /data/.master.key once.
MYCHATBOT_MASTER_KEY=

# Telegram chat interface security.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://bot.example.com
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REQUIRE_ALLOWLIST=true
TELEGRAM_ALLOWLIST=

# WhatsApp Cloud API. Keep real secrets only in Render/VPS environment variables.
# For temporary internal testing, set WHATSAPP_MOCK_MODE=true. It never calls Meta.
WHATSAPP_MOCK_MODE=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_REQUIRE_SIGNATURE=true
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# Keep secrets out of Git; this file is a template only.
