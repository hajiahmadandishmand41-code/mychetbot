# MyChatBot environment configuration
# Never commit a real .env file.

# ---- AI providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=openai/gpt-4o-mini

# ---- Security ----
# Leave empty to let MyChatBot generate ~/.mychatbot/.master.key on first use.
MYCHATBOT_MASTER_KEY=
ALLOW_SHELL=false
SHELL_WHITELIST=ls,pwd,whoami,df,uname,ping,curl
# Required for protected FastAPI endpoints. Generate locally; never commit it.
API_TOKEN=

# ---- Runtime / capabilities ----
# local = normal Linux, device = Termux/Android, server = VPS/Docker safe profile.
TOOL_PROFILE=local
MYCHATBOT_DATA=~/.mychatbot

# ---- Interfaces ----
TELEGRAM_BOT_TOKEN=
API_HOST=127.0.0.1
API_PORT=8765

# Docker/Compose overrides API_HOST=0.0.0.0 and MYCHATBOT_DATA=/data.
# Production additionally uses MYCHATBOT_DOMAIN in the VPS environment file.
