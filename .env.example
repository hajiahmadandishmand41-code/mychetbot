# ============================================================
# WEB (Next.js / Vercel) -> UNIFIED AGENT BACKEND
# ============================================================
# Put the PUBLIC HTTPS URL of the Python/FastAPI Backend here.
# Example: https://mychatbot-api.example.com
# Do NOT put the NaraRouter URL here.
MYCHATBOT_API_URL=https://YOUR-UNIFIED-AGENT-HOST

# Put the SAME secret value that the Backend uses as API_TOKEN.
# This is the Web -> Backend credential, NOT the Nara API key.
MYCHATBOT_API_TOKEN=

# ============================================================
# BACKEND (Python/FastAPI) -> NaraRouter
# ============================================================
# This is the real secret issued by NaraRouter.
# Keep it ONLY on the Backend/Render environment. Never expose it to Web.
NARA_API_KEY=
NARA_BASE_URL=https://router.bynara.id/v1
DEFAULT_MODEL=auto/bynara
NARA_FALLBACK_MODELS=agnes-2.5-flash,agnes-2.0-flash

# Legacy direct-Web variables are retained only for old tests/compatibility.
# New Web runtime must use MYCHATBOT_API_URL + MYCHATBOT_API_TOKEN.
NARA_MODEL=auto/bynara
NARA_FALLBACK_MODEL=agnes-2.5-flash

# ============================================================
# BACKEND API AUTHENTICATION
# ============================================================
# Create one strong random secret and use the SAME value for:
#   Backend: API_TOKEN
#   Web:     MYCHATBOT_API_TOKEN
# Never use NARA_API_KEY as API_TOKEN.
API_TOKEN=
TRUST_PROXY=false
API_HOST=127.0.0.1
API_PORT=8765

# ---- Persistent memory ----
MYCHATBOT_DATA=~/.mychatbot
MAX_INPUT_CHARS=12000
RECENT_HISTORY_MESSAGES=12
MEMORY_CONTEXT_MESSAGES=8
MEMORY_CONTEXT_FACTS=12
MEMORY_MAX_MESSAGES=1000
MEMORY_MAX_FACTS=100
MEMORY_MAX_MESSAGE_CHARS=12000

# ---- Internal tool policy ----
ALLOW_SHELL=false
SHELL_WHITELIST=pwd,ls,whoami,uname,date
AUTO_TOOLS=wifi_capabilities,wifi_info,wifi_scan,wifi_diagnostics,wifi_security_report,battery,local_ip,ping,dns_lookup,port_check,web_search,web_research,web_compare,server_diagnostics
TOOL_PROFILE=local

# ---- Public Web Research ----
WEB_RESEARCH_ENABLED=true
WEB_MAX_RESPONSE_BYTES=2000000
WEB_MAX_REDIRECTS=3
WEB_CONNECT_TIMEOUT=8
WEB_READ_TIMEOUT=15

# ---- Server runtime ----
SERVER_EXECUTION_ENABLED=false
SERVER_TIMEOUT_SECONDS=20
SERVER_MEMORY_LIMIT_MB=256
SERVER_PROCESS_LIMIT=16
SERVER_OUTPUT_LIMIT=12000
SERVER_ALLOWED_ENV=PATH,HOME,PYTHONPATH,PYTHONUNBUFFERED,PYTHONDONTWRITEBYTECODE
SERVER_SAFE_SCRIPTS=
SERVER_EXEC_ALLOWLIST=
SERVER_EXEC_ALLOWED_SESSIONS=

# ============================================================
# TELEGRAM — COMPLETELY SEPARATE INTERFACE
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REQUIRE_ALLOWLIST=false
TELEGRAM_ALLOWLIST=
