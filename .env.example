# MyChatBot — unified conversational production environment

# ---- NaraRouter ----
NARA_API_KEY=
NARA_BASE_URL=https://router.bynara.id/v1
# Required server-side model; never accept a model name from user input.
DEFAULT_MODEL=

# ---- API security ----
API_TOKEN=
TRUST_PROXY=false
API_HOST=127.0.0.1
API_PORT=8765
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Persistent memory ----
MYCHATBOT_DATA=~/.mychatbot
MAX_INPUT_CHARS=12000
RECENT_HISTORY_MESSAGES=12
MEMORY_CONTEXT_MESSAGES=8
MEMORY_CONTEXT_FACTS=12
MEMORY_MAX_MESSAGES=1000
MEMORY_MAX_FACTS=100
MEMORY_MAX_MESSAGE_CHARS=12000

# ---- Internal tool policy ----
# Shell is disabled by default. Never enable it merely because a user asks for it.
ALLOW_SHELL=false
SHELL_WHITELIST=pwd,ls,whoami,uname,date
# Only safe read-only tools listed here can be auto-selected by the conversational agent.
AUTO_TOOLS=wifi_capabilities,wifi_info,wifi_scan,wifi_diagnostics,wifi_security_report,battery,local_ip,ping,dns_lookup,port_check
# local is suitable for Termux/device runtimes; server deliberately cannot expose device-only tools.
TOOL_PROFILE=local

# ---- Telegram Chat ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REQUIRE_ALLOWLIST=false
TELEGRAM_ALLOWLIST=
