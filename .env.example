# MyChatBot — chat-only production environment

# ---- NaraRouter ----
NARA_API_KEY=
NARA_BASE_URL=https://router.bynara.id/v1
# Set the model here; the runtime never accepts a model from the user request.
DEFAULT_MODEL=deepseek-v4-flash

# ---- API security ----
API_TOKEN=
TRUST_PROXY=false
API_HOST=127.0.0.1
API_PORT=8765

# ---- Persistent memory ----
MYCHATBOT_DATA=~/.mychatbot
MAX_INPUT_CHARS=12000
RECENT_HISTORY_MESSAGES=12
MEMORY_CONTEXT_MESSAGES=8
MEMORY_CONTEXT_FACTS=12

# ---- Telegram Chat ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REQUIRE_ALLOWLIST=false
TELEGRAM_ALLOWLIST=
