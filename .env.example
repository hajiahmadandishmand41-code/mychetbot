# ---- Providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=openai/gpt-4o-mini

# ---- Security ----
MYCHATBOT_MASTER_KEY=            # اگر خالی باشد در اولین اجرا ساخته می‌شود
ALLOW_SHELL=false                # اجرای شل فقط با تایید صریح
SHELL_WHITELIST=ls,pwd,whoami,df,uname,ping,curl
API_TOKEN=change-me              # توکن دسترسی به FastAPI

# ---- Interfaces ----
TELEGRAM_BOT_TOKEN=
API_HOST=127.0.0.1
API_PORT=8765
