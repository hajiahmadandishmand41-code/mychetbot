# MyChatBot environment configuration
# Copy to .env and replace only the values you actually use.

# ---- AI Providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=openai/gpt-4o-mini

# ---- Security ----
# Leave empty to let MyChatBot generate ~/.mychatbot/.master.key on first use.
MYCHATBOT_MASTER_KEY=
ALLOW_SHELL=false
# Keep shell disabled in production. The default whitelist intentionally excludes curl.
SHELL_WHITELIST=ls,pwd,whoami,df,uname,ping
API_TOKEN=
TRUST_PROXY=false

# ---- Runtime / capabilities ----
TOOL_PROFILE=local
API_TOOL_PROFILE=server
MYCHATBOT_DATA=~/.mychatbot

# ---- Interfaces ----
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram chat IDs. Required when TELEGRAM_REQUIRE_ALLOWLIST=true.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_REQUIRE_ALLOWLIST=false
API_HOST=127.0.0.1
API_PORT=8765
